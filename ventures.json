window.__DEFAULTS={
  site:{name:"Rajan Adhikari",tagline:"Entrepreneur • Himalayan Guide • Founder",heroIntro:"I build businesses rooted in the Himalayas — guiding travelers across Nepal's greatest trails, running a modern barbershop, and growing an imports venture from Kathmandu.",photo:"",aboutHeading:"About Me",about:"I'm Rajan Adhikari, a Nepal-based entrepreneur. Edit this from the admin panel.",email:"hello@adhikari-rajan.com.np",phone:"",location:"Kathmandu, Nepal",socials:[]},
  ventures:{items:[{name:"Trekking & Expeditions",category:"Adventure Travel",description:"Guided treks and expeditions across Nepal.",link:"",image:""},{name:"Barbershop",category:"Grooming",description:"Modern cuts, beard grooming, and classic shaves.",link:"",image:""},{name:"Imports",category:"Trade",description:"Sourcing and importing quality goods into Nepal.",link:"",image:""}]},
  blog:{posts:[]}
};
