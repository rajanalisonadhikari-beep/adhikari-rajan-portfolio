:root{
  --text:#22201E;--muted:#6E6A64;--canvas:#FFFFFF;--soft:#F7F5F2;--surface:#F0EDE8;
  --border:#E6E2DB;--accent:#2E6F6A;--accent-soft:#E4F0EE;--accent-2:#C9793B;
  --maxw:1120px;--radius:14px;--shadow:0 1px 2px rgba(0,0,0,.05),0 8px 24px rgba(0,0,0,.05);
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
}
@media (prefers-color-scheme:dark){:root{--text:#F5F3F0;--muted:rgba(255,255,255,.65);--canvas:#181716;--soft:#201E1C;--surface:#2A2825;--border:rgba(255,255,255,.14);--accent:#5FB4AC;--accent-soft:rgba(95,180,172,.12);--accent-2:#DE9255;--shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);}}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--sans);color:var(--text);background:var(--canvas);line-height:1.6;font-size:16px;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;padding:13px 22px;border-radius:10px;font-weight:600;font-size:15px;transition:transform .15s ease,opacity .15s ease;min-height:44px}
.btn:hover{transform:translateY(-1px);opacity:.94}
.btn.ghost{background:transparent;color:var(--text);border:1px solid var(--border)}
.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:12.5px;font-weight:700;color:var(--accent)}

/* NAV */
header.nav{position:sticky;top:0;z-index:50;backdrop-filter:saturate(160%) blur(12px);background:color-mix(in srgb,var(--canvas) 82%,transparent);border-bottom:1px solid var(--border)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{font-weight:800;letter-spacing:-.02em;font-size:19px;display:flex;align-items:center;gap:10px}
.brand .mark{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;color:#fff;font-size:15px}
.nav-links{display:flex;gap:28px;align-items:center}
.nav-links a{font-size:15px;color:var(--muted);font-weight:500}
.nav-links a:hover{color:var(--text)}
.nav-toggle{display:none;background:none;border:0;cursor:pointer;padding:10px;font-size:22px;color:var(--text)}

/* HERO */
.hero{position:relative;overflow:hidden;padding:96px 0 120px}
.hero .wrap{position:relative;z-index:2;max-width:820px}
.hero h1{font-size:clamp(38px,6vw,68px);line-height:1.04;letter-spacing:-.03em;font-weight:800;margin:18px 0}
.hero p.lead{font-size:clamp(17px,2.2vw,21px);color:var(--muted);max-width:640px}
.hero .cta{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap}
.mountains{position:absolute;left:0;right:0;bottom:-1px;z-index:1;pointer-events:none}
.hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(1200px 500px at 75% -10%,var(--accent-soft),transparent 60%)}

/* SECTION */
section{padding:84px 0}
.section-head{max-width:640px;margin-bottom:44px}
.section-head h2{font-size:clamp(28px,4vw,40px);letter-spacing:-.02em;font-weight:800;margin:12px 0 10px}
.section-head p{color:var(--muted);font-size:17px}
.soft{background:var(--soft)}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:280px 1fr;gap:48px;align-items:center}
.about-photo{width:100%;aspect-ratio:1/1;border-radius:var(--radius);object-fit:cover;background:var(--surface);border:1px solid var(--border)}
.about-photo.placeholder{display:grid;place-items:center;color:var(--muted);font-size:48px}
.about-body :is(p){margin-bottom:14px;font-size:17px}

/* VENTURES */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.card{background:var(--canvas);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .18s ease}
.card:hover{transform:translateY(-4px)}
.card .thumb{aspect-ratio:16/10;background:linear-gradient(135deg,var(--accent-soft),var(--surface));display:grid;place-items:center;color:var(--accent);font-size:34px}
.card .thumb img{width:100%;height:100%;object-fit:cover}
.card .body{padding:22px;display:flex;flex-direction:column;gap:10px;flex:1}
.card .cat{font-size:12.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
.card h3{font-size:20px;letter-spacing:-.01em}
.card p{color:var(--muted);font-size:15px;flex:1}
.card a.more{font-weight:600;color:var(--accent);font-size:15px}

/* BLOG */
.posts{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}
.post{border:1px solid var(--border);border-radius:var(--radius);padding:24px;background:var(--canvas)}
.post .date{font-size:13px;color:var(--muted);font-weight:600}
.post h3{margin:8px 0;font-size:20px;letter-spacing:-.01em}
.post p{color:var(--muted);font-size:15px}

/* CONTACT */
.contact-card{background:var(--canvas);border:1px solid var(--border);border-radius:var(--radius);padding:40px;box-shadow:var(--shadow);text-align:center;max-width:640px;margin:0 auto}
.contact-card h2{font-size:30px;letter-spacing:-.02em;margin-bottom:10px}
.contact-card p{color:var(--muted);margin-bottom:8px}
.socials{display:flex;gap:12px;justify-content:center;margin-top:22px;flex-wrap:wrap}
.socials a{border:1px solid var(--border);padding:10px 18px;border-radius:999px;font-size:14px;font-weight:600;min-height:44px;display:inline-flex;align-items:center}
.socials a:hover{border-color:var(--accent);color:var(--accent)}

/* FOOTER */
footer{border-top:1px solid var(--border);padding:34px 0;color:var(--muted);font-size:14px}
.foot-inner{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}

@media (max-width:820px){
  .nav-links{position:fixed;inset:64px 0 auto 0;flex-direction:column;background:var(--canvas);border-bottom:1px solid var(--border);padding:18px 24px;gap:18px;display:none}
  .nav-links.open{display:flex}
  .nav-toggle{display:block}
  .about-grid{grid-template-columns:1fr;gap:28px}
  .about-photo{max-width:240px}
  .cards{grid-template-columns:1fr}
  .posts{grid-template-columns:1fr}
  section{padding:60px 0}
  .hero{padding:64px 0 90px}
}
